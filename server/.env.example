# Path to the SQLite database file, created automatically on first run.
# Lives alongside LOCAL_STORAGE_DIR so a full backup is just: cp -r data/ backup/
DATABASE_URL=./data/shareblog.db

# Port the Fastify server listens on.
PORT=3000

# Base domain sites are served under: <subdomain>.<BASE_DOMAIN>
# Local dev: use *.localhost, which resolves automatically with no /etc/hosts changes.
BASE_DOMAIN=localhost:3000

# Base host the API is served under (kept separate from the tenant-routed site host).
API_BASE_URL=http://api.localhost:3000

# local | s3  (s3 not implemented yet — placeholder for later)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads

# development | production
# In development, auth codes/links are logged to the console instead of emailed.
NODE_ENV=development

# Keeps the personal My Work and Contact pages private while they are being developed.
# Set to true in your local .env to preview /my-work and /contact.
ENABLE_WORK_PAGE=false

# Only read when NODE_ENV=production. Uberspace provides SMTP as part of hosting.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Shareblog <noreply@example.com>

# Optional — used as a secondary fallback if Open Library returns no results.
GOOGLE_BOOKS_API_KEY=

# Comma-separated list of emails allowed to sign in / create an account.
# Required when NODE_ENV=production unless DISABLE_EMAIL_AUTH=true — the
# server refuses to boot without one of those protections (see server.ts),
# since otherwise anyone who finds the API could create an account and site.
# Leave unset for local dev, where that does not matter.
ALLOWED_SIGNUP_EMAILS=

# Optional hard off-switch for email codes and magic links. A dedicated App
# Review instance can set this to true and use only the hashed review pairing
# credential below, avoiding an unnecessary SMTP account and auth surface.
DISABLE_EMAIL_AUTH=false

# Optional App Store Review access for a disposable test site. Configure all
# four together only on a dedicated review server. Generate the credential with
# `npm run app-review:credential`; store only its SHA-256 hash here. The access
# code remains reusable until these values are removed or its hash is rotated.
# APP_REVIEW_EMAIL=app-review@example.com
# APP_REVIEW_ACCESS_CODE_HASH=replace-with-the-generated-64-character-hash
# APP_REVIEW_SITE_SUBDOMAIN=review
# APP_REVIEW_SITE_TITLE=Flightstead Review
