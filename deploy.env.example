# Copy to deploy.env (gitignored) and fill in your own values.
# Used by deploy.sh — see the "Automating this" section in UBERSPACE.md.

UBERSPACE_USER=yourusername
UBERSPACE_HOST=stardust.uberspace.de
# Path to the repo clone on the Uberspace box (see UBERSPACE.md step 1).
REMOTE_PATH=/home/yourusername/flightstead
# HTTPS, not git@ — the Uberspace box has no GitHub credentials of its own,
# so this only works if the repo is public.
REPO_URL=https://github.com/yourusername/flightstead.git
# Supervisor process name. Existing installations may still use "shareblog";
# deploy.sh defaults to that name when this setting is omitted.
SERVICE_NAME=flightstead
