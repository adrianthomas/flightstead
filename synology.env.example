# Copy this file to synology.env beside compose.synology.yml.
NODE_ENV=production
PORT=3000

# Public hostnames. Do not include https:// or a trailing slash in BASE_DOMAIN.
BASE_DOMAIN=example.com
API_BASE_URL=https://api.example.com

# Both the SQLite database and uploaded files live in the compose data mount.
DATABASE_URL=/app/data/shareblog.db
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/app/data/uploads

# The server refuses to start in production unless this is set. Separate
# multiple addresses with commas.
ALLOWED_SIGNUP_EMAILS=you@example.com

# Required for email sign-in after the initial QR pairing.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=replace-me
SMTP_FROM=Flightstead <you@example.com>

# Optional site-wide pages and metadata lookup.
ENABLE_WORK_PAGE=false
ENABLE_IMPRESSUM_PAGE=false
GOOGLE_BOOKS_API_KEY=
