server {
    listen 80;
    listen [::]:80;
    server_name flightstead.com www.flightstead.com;

    root /srv/flightstead-site/dist;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /assets/ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public";
    }
}
